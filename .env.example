# Chave privada da YouTube Data API v3. Configure somente no servidor/cofre de segredos.
YOUTUBE_API_KEY=

# IDs oficiais (não são chaves secretas).
YOUTUBE_CHANNEL_ID=
YOUTUBE_PLAYLIST_SERMONS=PLtxhs7GCODCb1bP8VYrlEMu2jG8nz9QmT
YOUTUBE_PLAYLIST_SERVICES=
YOUTUBE_PLAYLIST_EVENTS=

# Origem HTTPS oficial do site, após domínio ser definido. Sem valor, URLs canônicas não são emitidas.
NEXT_PUBLIC_SITE_URL=

# MongoDB Atlas. MONGODB_DB_NAME afeta somente o conteúdo do site.
MONGODB_URI=
# Opcional: banco que contém site_content; vazio usa o banco indicado na URI.
MONGODB_DB_NAME=
# Autenticação separada; os defaults correspondem ao banco auth e à coleção auth do Compass.
ADMIN_DB_NAME=auth
ADMIN_USERS_COLLECTION=auth
ADMIN_EMAIL=
# Gere localmente com: openssl rand -base64 48 (mínimo 32 bytes).
ADMIN_SESSION_SECRET=
